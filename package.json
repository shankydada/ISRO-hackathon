    "class-variance-authority": "latest",
    "clsx": "latest",
    "lenis": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "16.4.3",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
